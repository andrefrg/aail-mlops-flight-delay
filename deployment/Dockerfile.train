FROM python:3.10
WORKDIR /app
COPY requirements-baseline.txt ./
RUN pip install --no-cache-dir -r requirements-baseline.txt
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
COPY train.py ./
RUN mkdir -p data models reports docs
ENTRYPOINT ["python", "train.py"]
CMD ["--data-dir", "/data"]
